<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="NMSE.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <!-- Semi supplies the control templates and interaction states; the NMSE
             theme below repaints them. Locale is left at default so Semi does not
             force a font stack of its own over the one in NmseTokens. -->
        <semi:SemiTheme />
        <StyleInclude Source="avares://Semi.Avalonia.DataGrid/Index.axaml" />
        <StyleInclude Source="avares://NMSE/UI/Themes/NmseTheme.axaml" />
    </Application.Styles>
</Application>
