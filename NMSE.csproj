<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyTitle>NO MAN'S SAVE EDITOR</AssemblyTitle>
		<Description>NO MAN'S SAVE EDITOR (Open Source Save Editor for No Man's Sky)</Description>
		<RootNamespace>NMSE</RootNamespace>

		<!-- Windows-only PE icon; ignored when publishing for Linux/macOS. -->
		<ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Resources\app\NMSE.ico</ApplicationIcon>

		<TieredPGO>true</TieredPGO>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

		<!-- Avalonia resolves control themes by reflection over the assembly, so the
		     trimmer needs a conservative mode. Native AOT is opted into explicitly at
		     publish time (see Build/NativeAOT.props) rather than by configuration. -->
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

	<Import Project="Build\NativeAOT.props" />

	<!-- Sibling projects and the archived WinForms UI are not part of this assembly. -->
	<ItemGroup>
		<Compile Remove="Build\**;NMSE.Tests\**;NMSE.Extractor\**;NMSE.Extractor.Tests\**;NMSE.Site\**;_legacy_ui\**;_ref\**" />
		<Content Remove="Build\**;NMSE.Tests\**;NMSE.Extractor\**;NMSE.Extractor.Tests\**;NMSE.Site\**;_legacy_ui\**;_ref\**" />
		<EmbeddedResource Remove="Build\**;NMSE.Tests\**;NMSE.Extractor\**;NMSE.Extractor.Tests\**;NMSE.Site\**;_legacy_ui\**;_ref\**" />
		<None Remove="Build\**;NMSE.Tests\**;NMSE.Extractor\**;NMSE.Extractor.Tests\**;NMSE.Site\**;_legacy_ui\**;_ref\**" />
		<AvaloniaXaml Remove="_legacy_ui\**" />
		<Compile Remove="BuildInfo.g.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.12" />
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.12" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
		<PackageReference Include="Semi.Avalonia" Version="11.3.7.3" />
		<PackageReference Include="Semi.Avalonia.DataGrid" Version="11.3.7.3" />
		<PackageReference Include="AvaloniaEdit.TextMate" Version="11.3.0" />
		<PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
		<PackageReference Include="Avalonia.Diagnostics" Version="11.3.12">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<!-- Avalonia.FreeDesktop pulls 0.21.2, which is affected by GHSA-xrw6-gwf8-vvr9
		     (spoofed D-Bus signals / fd exhaustion). This is the transport behind the XDG
		     portal file dialogs on Linux, so pin the patched build of the same line. -->
		<PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
	</ItemGroup>

	<!-- Game data, icons and localisation are read from disk at runtime. -->
	<ItemGroup>
		<Content Include="Resources\map\**\*;Resources\json\**\*;Resources\icons\**\*;Resources\images\**\*;Resources\ui\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<None Remove="Resources\app\TOOLS.ico" />
	</ItemGroup>

	<!-- Fonts are embedded so Avalonia can resolve them via avares:// URIs. -->
	<ItemGroup>
		<AvaloniaResource Include="Resources\app\NMSGeoSans_Kerned.ttf" />
		<AvaloniaResource Include="Resources\app\NMS_Glyphs_Mono.ttf" />
		<AvaloniaResource Include="Resources\app\NMSE.ico" />
		<AvaloniaResource Include="UI\Styles\**\*" />
		<AvaloniaResource Include="UI\Themes\**\*" />
	</ItemGroup>

	<!-- == Version from version.json ================================ -->
	<Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
		<PropertyGroup>
			<VersionJsonPath>$(MSBuildProjectDirectory)/version.json</VersionJsonPath>
			<GeneratedFile>$(MSBuildProjectDirectory)/BuildInfo.g.cs</GeneratedFile>
		</PropertyGroup>

		<ReadLinesFromFile File="$(VersionJsonPath)">
			<Output TaskParameter="Lines" ItemName="_VersionLines" />
		</ReadLinesFromFile>

		<PropertyGroup>
			<_VersionText>@(_VersionLines, '')</_VersionText>
			<_VerMajor>$([System.Text.RegularExpressions.Regex]::Match('$(_VersionText)', '"major"\s*:\s*(\d+)').Groups[1].Value)</_VerMajor>
			<_VerMinor>$([System.Text.RegularExpressions.Regex]::Match('$(_VersionText)', '"minor"\s*:\s*(\d+)').Groups[1].Value)</_VerMinor>
			<_VerPatch>$([System.Text.RegularExpressions.Regex]::Match('$(_VersionText)', '"patch"\s*:\s*(\d+)').Groups[1].Value)</_VerPatch>
			<_VerMajor Condition="'$(_VerMajor)'==''">0</_VerMajor>
			<_VerMinor Condition="'$(_VerMinor)'==''">0</_VerMinor>
			<_VerPatch Condition="'$(_VerPatch)'==''">0</_VerPatch>
			<NmseVersion>$(_VerMajor).$(_VerMinor).$(_VerPatch)</NmseVersion>
			<Version>$(NmseVersion)</Version>
		</PropertyGroup>

		<WriteLinesToFile File="$(GeneratedFile)" Overwrite="true" Lines="namespace NMSE&#xD;&#xA;{&#xD;&#xA;    public static class BuildInfo&#xD;&#xA;    {&#xD;&#xA;        public const string VerMajor = &quot;$(_VerMajor)&quot;%3b&#xD;&#xA;        public const string VerMinor = &quot;$(_VerMinor)&quot;%3b&#xD;&#xA;        public const string VerPatch = &quot;$(_VerPatch)&quot;%3b&#xD;&#xA;    }&#xD;&#xA;}" />

		<ItemGroup>
			<Compile Include="$(GeneratedFile)" />
		</ItemGroup>
	</Target>

</Project>
