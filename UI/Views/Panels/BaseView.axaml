<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NMSE.UI.ViewModels.Panels"
             xmlns:controls="using:NMSE.UI.Views.Controls"
             xmlns:cvm="using:NMSE.UI.ViewModels.Controls"
             xmlns:loc="using:NMSE.UI.Localization"
             x:Class="NMSE.UI.Views.Panels.BaseView"
             x:DataType="vm:BaseViewModel">

    <Border Classes="card" Padding="16" Margin="4">
        <DockPanel>
            <TextBlock Text="{loc:Locale tab.bases_storage}" Classes="sectionHeader"
                       DockPanel.Dock="Top" Margin="0,0,0,12" />

            <TabControl SelectedIndex="{Binding SelectedTabIndex}">
                <!-- Bases Tab -->
                <TabItem Header="{loc:Locale base.tab_bases}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" Margin="8">
                            <!-- NPC Workers Section -->
                            <Border Classes="card" Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{loc:Locale base.npc_header}" Classes="sectionHeader" />
                                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Locale base.npc_label}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding NpcWorkers}"
                                                  SelectedItem="{Binding SelectedNpc}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NpcWorkerViewModel">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Locale base.npc_seed_label}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                                            <TextBox Text="{Binding NpcSeed}" Width="250" />
                                            <Button Content="{loc:Locale common.gen}" Command="{Binding GenerateNpcSeedCommand}" />
                                            <Button Content="{loc:Locale base.summon_npc}" Command="{Binding SummonWorkerCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Base Info Section -->
                            <Border Classes="card" Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{loc:Locale base.base_header}" Classes="sectionHeader" />
                                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" Margin="0,8,0,0">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Locale base.base_label}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Bases}"
                                                  SelectedItem="{Binding SelectedBase}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BaseInfoViewModel">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Locale base.name_label}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                                            <TextBox Text="{Binding BaseName}" Width="250" />
                                            <Button Content="{loc:Locale base.chest_rename}" Command="{Binding SaveBaseNameCommand}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Locale base.items_label}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BaseItemCount}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                        <Button Content="{loc:Locale base.export}" Command="{Binding ExportBaseCommand}" />
                                        <Button Content="{loc:Locale base.import}" Command="{Binding ImportBaseCommand}" />
                                        <Button Content="{loc:Locale base.move_basecomp}" Command="{Binding MoveBaseComputerCommand}" />
                                        <Button Content="{loc:Locale base.delete_base}" Classes="danger"
                                                Command="{Binding DeleteBaseCommand}" />
                                    </StackPanel>

                                    <TextBlock Text="{loc:Locale base.move_basecomp_warning}" Classes="hint"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />

                                    <!-- Order within PersistentPlayerBases decides which base the
                                         game treats as primary, so it is worth controlling. -->
                                    <TextBlock Text="{loc:Locale base.move_base_in_list}" Classes="label"
                                               Margin="0,12,0,0" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="{loc:Locale base.move_base_to_top}" Command="{Binding MoveBaseToTopCommand}" />
                                        <Button Content="{loc:Locale base.move_base_up}" Command="{Binding MoveBaseUpCommand}" />
                                        <Button Content="{loc:Locale base.move_base_down}" Command="{Binding MoveBaseDownCommand}" />
                                        <Button Content="{loc:Locale base.move_base_to_bottom}" Command="{Binding MoveBaseToBottomCommand}" />
                                        <Rectangle Width="1" Height="20" Margin="4,0" Fill="{DynamicResource NmseBorderBrush}" />
                                        <Button Content="{loc:Locale base.sort_az}" Command="{Binding SortBasesAscendingCommand}" />
                                        <Button Content="{loc:Locale base.sort_za}" Command="{Binding SortBasesDescendingCommand}" />
                                    </StackPanel>

                                    <!-- Terrain edits accumulate without bound and are the usual
                                         reason a save grows large. -->
                                    <Rectangle Height="1" Fill="{DynamicResource NmseBorderBrush}" Margin="0,14,0,10" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="{loc:Locale base.clear_terrain}" Command="{Binding ClearTerrainCommand}" />
                                        <Button Content="{loc:Locale base.clear_all_terrain_except_bases}"
                                                Command="{Binding ClearAllTerrainExceptBasesCommand}" />
                                        <Button Content="{loc:Locale base.clear_all_terrain}" Classes="danger"
                                                Command="{Binding ClearAllTerrainCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Chests Tab -->
                <TabItem Header="{loc:Locale base.tab_chests}">
                  <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Locale base.chest_name_label}" Classes="label" />
                        <TextBox Text="{Binding ChestName}" Width="240"
                                 Watermark="{loc:Locale base.chest_name_placeholder}" />
                        <Button Content="{loc:Locale base.chest_rename}" Command="{Binding RenameChestCommand}" />
                        <Button Content="{loc:Locale base.chest_clear_name}" Command="{Binding ClearChestNameCommand}"
                                ToolTip.Tip="{loc:Locale base.chest_clear_name}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{loc:Locale base.chest_warning}"
                               Classes="hint" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TabControl SelectedIndex="{Binding SelectedChestIndex}" ItemsSource="{Binding ChestGrids}">
                        <TabControl.ItemTemplate>
                            <DataTemplate x:DataType="cvm:InventoryGridViewModel">
                                <TextBlock Text="{Binding InventoryGroup, FallbackValue='Chest'}" />
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate x:DataType="cvm:InventoryGridViewModel">
                                <controls:InventoryGridControl DataContext="{Binding}" />
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                  </DockPanel>
                </TabItem>

                <!-- Storage Tab -->
                <TabItem Header="{loc:Locale base.tab_storage}">
                    <TabControl ItemsSource="{Binding StorageTabs}">
                        <TabControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StorageTabViewModel">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:StorageTabViewModel">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Warning}"
                                               Foreground="{DynamicResource NmseWarningBrush}"
                                               TextWrapping="Wrap" Margin="8,8,8,4"
                                               IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <controls:InventoryGridControl DataContext="{Binding Grid}" />
                                </DockPanel>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </TabItem>
                <!-- Objects Tab -->
                <TabItem Header="{loc:Locale base.objects_tab}">
                    <Grid ColumnDefinitions="380,12,*" Margin="8">
                        <DockPanel Grid.Column="0">
                            <TextBox DockPanel.Dock="Top" Text="{Binding ObjectFilter}"
                                     Watermark="{loc:Locale base.objects_filter}" Margin="0,0,0,8" />
                            <ListBox ItemsSource="{Binding BaseObjects}"
                                     SelectedItem="{Binding SelectedObject}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BaseObjectViewModel">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Locale base.obj_heading}"
                                       Classes="sectionHeader" />
                            <TextBox Text="{Binding ObjectDetails}" Classes="mono"
                                     IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="NoWrap" FontSize="12" />
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
