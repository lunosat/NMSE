<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NMSE.UI.ViewModels.Panels"
             xmlns:loc="using:NMSE.UI.Localization"
             x:Class="NMSE.UI.Views.Panels.CompanionView"
             x:DataType="vm:CompanionViewModel">

    <Border Classes="card" Padding="16" Margin="4">
        <DockPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="{loc:Locale companion.title}" Classes="sectionHeader"
                           VerticalAlignment="Center" Margin="0,0,4,0" />
                <Button Classes="gotoJson" Padding="6,2" Command="{Binding GoToPetsJsonCommand}"
                        ToolTip.Tip="{Binding GoToPetsTooltip}" />
                <Button Classes="gotoJson" Padding="6,2" Command="{Binding GoToSelectedJsonCommand}"
                        ToolTip.Tip="{Binding GoToSelectedTooltip}" />
                <Button Classes="gotoJson" Padding="6,2" Command="{Binding GoToEggsJsonCommand}"
                        ToolTip.Tip="{Binding GoToEggsTooltip}" />
                <Button Classes="gotoJson" Padding="6,2" Command="{Binding GoToBattleTeamJsonCommand}"
                        ToolTip.Tip="{Binding GoToBattleTeamTooltip}" />
            </StackPanel>
            <TextBlock Text="{Binding CountLabel}" DockPanel.Dock="Top" Margin="0,0,0,12"
                       Foreground="{DynamicResource NmseText1Brush}" />

            <Grid ColumnDefinitions="220,*">
                <!-- Companion List -->
                <Border Grid.Column="0" Classes="card" Padding="4" Margin="0,0,8,0">
                    <ListBox ItemsSource="{Binding Companions}" SelectedItem="{Binding SelectedCompanion}"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CompanionEntryViewModel">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Companion Details -->
                <ScrollViewer Grid.Column="1" IsVisible="{Binding HasSelection}">
                    <StackPanel Spacing="12" Margin="8">
                        <Border Classes="card" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Locale companion.identity}" Classes="sectionHeader" />
                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,8,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Locale companion.name}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CompanionName}" Watermark="{loc:Locale common.procedural_no_name}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Locale companion.creature_id}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CreatureId}" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Locale companion.biome}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Biome}" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Locale companion.type}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CreatureType}" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Locale companion.custom_species_name}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CustomSpeciesName}" Margin="0,4,0,0" />

                                    <!-- What the creature id resolves to, or the id marked
                                         as one the databases do not know. -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Locale companion.species}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Species}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Locale companion.seeds}" Classes="sectionHeader" />
                                <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,8,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Locale companion.creature_seed}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CreatureSeed}" />
                                    <Button Grid.Row="0" Grid.Column="2" Content="{loc:Locale companion.gen}" Command="{Binding GenerateSeedCommand}" CommandParameter="Creature" Margin="4,0,0,0" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Locale companion.secondary_seed}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SecondarySeed}" Margin="0,4,0,0" />
                                    <Button Grid.Row="1" Grid.Column="2" Content="{loc:Locale companion.gen}" Command="{Binding GenerateSeedCommand}" CommandParameter="Secondary" Margin="4,4,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Locale companion.species_seed}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SpeciesSeed}" Margin="0,4,0,0" />
                                    <Button Grid.Row="2" Grid.Column="2" Content="{loc:Locale companion.gen}" Command="{Binding GenerateSeedCommand}" CommandParameter="Species" Margin="4,4,0,0" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Locale companion.genus_seed}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding GenusSeed}" Margin="0,4,0,0" />
                                    <Button Grid.Row="3" Grid.Column="2" Content="{loc:Locale companion.gen}" Command="{Binding GenerateSeedCommand}" CommandParameter="Genus" Margin="4,4,0,0" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Locale companion.bone_scale_seed}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding BoneScaleSeed}" Margin="0,4,0,0" />
                                    <Button Grid.Row="4" Grid.Column="2" Content="{loc:Locale companion.gen}" Command="{Binding GenerateSeedCommand}" CommandParameter="BoneScale" Margin="4,4,0,0" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Locale companion.colour_base_seed}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ColourBaseSeed}" Margin="0,4,0,0" />
                                    <Button Grid.Row="5" Grid.Column="2" Content="{loc:Locale companion.gen}" Command="{Binding GenerateSeedCommand}" CommandParameter="ColourBase" Margin="4,4,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Locale companion.tab_stats}" Classes="sectionHeader" />
                                <!-- Several of these feed the procedural name, so editing
                                     one can rename the companion. -->
                                <TextBlock Text="{loc:Locale companion.stats_warning}" Classes="hint"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Locale companion.attributes}" Classes="label" />
                                <Grid ColumnDefinitions="140,200" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,8,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Locale companion.scale}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Scale}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Locale companion.trust}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Trust}" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Locale companion.predator}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding Predator}" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Locale companion.has_fur}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding HasFur}" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Locale companion.helpfulness}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Helpfulness}" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Locale companion.aggression}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Aggression}" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Locale companion.independence}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Independence}" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:Locale companion.hungry}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Hungry}" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{loc:Locale companion.lonely}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Lonely}" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="{loc:Locale companion.egg_modified}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding EggModified}" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="{loc:Locale companion.summoned}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <CheckBox Grid.Row="10" Grid.Column="1" IsChecked="{Binding HasBeenSummoned}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="11" Grid.Column="0" Text="{loc:Locale companion.allow_reroll}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <CheckBox Grid.Row="11" Grid.Column="1" IsChecked="{Binding AllowUnmodifiedReroll}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="12" Grid.Column="0" Text="{loc:Locale companion.slot_unlocked}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <CheckBox Grid.Row="12" Grid.Column="1" IsChecked="{Binding SlotUnlocked}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="13" Grid.Column="0" Text="{loc:Locale companion.birth_time}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <DatePicker Grid.Row="13" Grid.Column="1" SelectedDate="{Binding BirthTime}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="14" Grid.Column="0" Text="{loc:Locale companion.last_egg_time}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <DatePicker Grid.Row="14" Grid.Column="1" SelectedDate="{Binding LastEggTime}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="15" Grid.Column="0" Text="{loc:Locale companion.trust_increase}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <DatePicker Grid.Row="15" Grid.Column="1" SelectedDate="{Binding LastTrustIncreaseTime}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="16" Grid.Column="0" Text="{loc:Locale companion.trust_decrease}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <DatePicker Grid.Row="16" Grid.Column="1" SelectedDate="{Binding LastTrustDecreaseTime}" Margin="0,4,0,0" />
                                    <!-- Some saves store UA as a hex string, others as a
                                         number; the box records which so a round trip
                                         writes back the form it found. -->
                                    <TextBlock Grid.Row="17" Grid.Column="0" Text="{loc:Locale companion.ua}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    <DockPanel Grid.Row="17" Grid.Column="1" Margin="0,4,0,0">
                                        <CheckBox DockPanel.Dock="Right" Content="0x" Margin="6,0,0,0"
                                                  IsChecked="{Binding UaIsHex}" />
                                        <TextBox Text="{Binding Ua}" />
                                    </DockPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Creature builder: the parts the creature is assembled from.
                             Picking one can expose further groups beneath it, so the list
                             rebuilds after every change. -->
                        <Border Classes="card" Padding="12">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{loc:Locale companion.descriptors}"
                                               Classes="sectionHeader" VerticalAlignment="Center" />
                                    <Button Content="{loc:Locale companion.regen_descriptor_id}"
                                            Command="{Binding RegenerateDescriptorIdCommand}" />
                                    <Button Content="{loc:Locale companion.creature_builder}"
                                            Command="{Binding OpenCreatureBuilderCommand}" />
                                </StackPanel>

                                <TextBlock Text="{Binding DescriptorSummary}" TextWrapping="Wrap"
                                           Classes="hint"
                                           IsVisible="{Binding !HasDescriptorGroups}" />

                                <ItemsControl ItemsSource="{Binding DescriptorGroups}"
                                              IsVisible="{Binding HasDescriptorGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DescriptorGroupViewModel">
                                            <Grid ColumnDefinitions="150,*" Margin="0,3">
                                                <TextBlock Text="{Binding Label}" Classes="label"
                                                           VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                                          SelectedIndex="{Binding SelectedIndex}"
                                                          HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Accessories: which slots exist depends on the creature and on
                             its descriptors, so the list is built per companion. -->
                        <Border Classes="card" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Locale companion.accessory_customisation}"
                                           Classes="sectionHeader" />
                                <!-- Which slots exist depends on the creature; some have none. -->
                                <TextBlock Text="{Binding AccessoryNote}" Classes="hint"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding !HasAccessories}" />
                                <ItemsControl ItemsSource="{Binding AccessorySlots}"
                                              IsVisible="{Binding HasAccessories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AccessorySlotViewModel">
                                            <Grid ColumnDefinitions="70,*,60,44,44" Margin="0,3" ColumnSpacing="6">
                                                <TextBlock Text="{Binding Label}" Classes="label" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                                          SelectedIndex="{Binding SelectedIndex}"
                                                          HorizontalAlignment="Stretch" />
                                                <NumericUpDown Grid.Column="2" Value="{Binding Scale}"
                                                               Increment="0.1" FormatString="F2"
                                                               Minimum="0" Maximum="10"
                                                               ShowButtonSpinner="False"
                                                               ToolTip.Tip="{loc:Locale companion.accessory_scale}" />
                                                <Button Grid.Column="3" Height="26" Padding="0"
                                                        Background="{Binding PrimaryColour}"
                                                        ToolTip.Tip="{loc:Locale companion.accessory_primary_colour}">
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <ItemsControl ItemsSource="{Binding Choices}" Width="300">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:ShipPaletteSwatch">
                                                                        <Button Width="26" Height="26" Margin="2" Padding="0"
                                                                                Background="{Binding Brush}"
                                                                                ToolTip.Tip="{Binding Name}"
                                                                                Tag="{Binding $parent[ItemsControl].DataContext}"
                                                                                Click="OnAccessoryPrimaryClick" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <Button Grid.Column="4" Height="26" Padding="0"
                                                        Background="{Binding AltColour}"
                                                        ToolTip.Tip="{loc:Locale companion.accessory_alt_colour}">
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <ItemsControl ItemsSource="{Binding Choices}" Width="300">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:ShipPaletteSwatch">
                                                                        <Button Width="26" Height="26" Margin="2" Padding="0"
                                                                                Background="{Binding Brush}"
                                                                                ToolTip.Tip="{Binding Name}"
                                                                                Tag="{Binding $parent[ItemsControl].DataContext}"
                                                                                Click="OnAccessoryAltClick" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Pet battle -->
                        <Border Classes="card" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Locale companion.tab_battle}" Classes="sectionHeader" />

                                <!-- Affinity comes from the creature and the biome it was
                                     found in, and decides its matchups. -->
                                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="4" Margin="0,4,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Locale companion.battle_affinity}"
                                               Classes="label" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BattleAffinity}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Locale companion.battle_strong}"
                                               Classes="label" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BattleStrong}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Locale companion.battle_weak}"
                                               Classes="label" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BattleWeak}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="{loc:Locale companion.battle_move_list}" Classes="label"
                                           Margin="0,8,0,0" />
                                <ItemsControl ItemsSource="{Binding MoveSlots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BattleMoveSlotViewModel">
                                            <Grid ColumnDefinitions="90,*" Margin="0,3">
                                                <TextBlock Text="{Binding Label}" Classes="label" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <ComboBox ItemsSource="{Binding Options}"
                                                              SelectedIndex="{Binding SelectedIndex}"
                                                              HorizontalAlignment="Stretch" />
                                                    <TextBlock Text="{Binding Detail}" Classes="hint"
                                                               TextWrapping="Wrap" />
                                                    <!-- From the save's legacy move list,
                                                         which the game no longer reads. -->
                                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                                IsVisible="{Binding HasLegacyValues}">
                                                        <TextBlock Text="{loc:Locale companion.battle_cooldown}"
                                                                   Classes="hint" />
                                                        <TextBlock Text="{Binding LegacyCooldown}" Classes="hint" />
                                                        <TextBlock Text="{loc:Locale companion.battle_score_boost}"
                                                                   Classes="hint" Margin="8,0,0,0" />
                                                        <TextBlock Text="{Binding LegacyScoreBoost}" Classes="hint" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{loc:Locale companion.battle_stat_overrides}"
                                           Classes="label" Margin="0,10,0,0" />
                                <CheckBox Content="{loc:Locale companion.battle_override_classes}"
                                          IsChecked="{Binding UseStatOverrides}" />
                                <Grid ColumnDefinitions="120,90,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                      RowSpacing="4" IsEnabled="{Binding UseStatOverrides}">
                                    <TextBlock Grid.Row="0" Text="{loc:Locale companion.battle_health}" Classes="label" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding StatClasses}"
                                              SelectedIndex="{Binding HealthClassIndex}" />
                                    <TextBlock Grid.Row="1" Text="{loc:Locale companion.battle_agility}" Classes="label" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding StatClasses}"
                                              SelectedIndex="{Binding AgilityClassIndex}" />
                                    <TextBlock Grid.Row="2" Text="{loc:Locale companion.battle_combat_effectiveness}" Classes="label" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding StatClasses}"
                                              SelectedIndex="{Binding CombatClassIndex}" />
                                    <TextBlock Grid.Row="3" Text="{loc:Locale companion.battle_average_class}" Classes="label" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AverageClass}"
                                               Foreground="{DynamicResource NmseAccentBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="{loc:Locale companion.battle_treats_heading}"
                                           Classes="label" Margin="0,10,0,0" />
                                <Grid ColumnDefinitions="120,90" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <TextBlock Grid.Row="0" Text="{loc:Locale companion.battle_treats_health}" Classes="label" />
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding TreatsHealth}"
                                                   Minimum="0" Maximum="10" FormatString="0" />
                                    <TextBlock Grid.Row="1" Text="{loc:Locale companion.battle_treats_agility}" Classes="label" />
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding TreatsAgility}"
                                                   Minimum="0" Maximum="10" FormatString="0" />
                                    <TextBlock Grid.Row="2" Text="{loc:Locale companion.battle_treats_combat}" Classes="label" />
                                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding TreatsCombat}"
                                                   Minimum="0" Maximum="10" FormatString="0" />
                                </Grid>

                                <Grid ColumnDefinitions="150,120,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                      RowSpacing="4" Margin="0,10,0,0">
                                    <TextBlock Grid.Row="0" Text="{loc:Locale companion.battle_genes_available}" Classes="label" />
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding GenesAvailable}"
                                                   Minimum="0" Maximum="1000" FormatString="0" />
                                    <TextBlock Grid.Row="1" Text="{loc:Locale companion.battle_genes_level}" Classes="label" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GenesLevel}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="{loc:Locale companion.battle_mutation_progress}" Classes="label" />
                                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MutationProgress}"
                                                   Increment="0.05" FormatString="F3" Minimum="0" Maximum="1" />
                                    <TextBlock Grid.Row="3" Text="{loc:Locale companion.battle_victories}" Classes="label" />
                                    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Victories}"
                                                   Minimum="0" Maximum="999999" FormatString="0" />
                                </Grid>

                                <TextBlock Text="{loc:Locale companion.battle_team}" Classes="label"
                                           Margin="0,10,0,0" />
                                <ItemsControl ItemsSource="{Binding TeamSlots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BattleTeamSlotViewModel">
                                            <Grid ColumnDefinitions="90,*" Margin="0,3">
                                                <TextBlock Text="{Binding Label}" Classes="label" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                                          SelectedIndex="{Binding SelectedIndex}"
                                                          HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{loc:Locale common.apply}" Classes="primary"
                                    Command="{Binding SaveCompanionChangesCommand}" />
                            <Button Content="{loc:Locale companion.accessory_reset}" Command="{Binding ResetAccessoryCommand}" />
                            <Button Content="{loc:Locale companion.battle_mutation_heading}"
                                    Command="{Binding ResetBattleDataCommand}" />
                            <!-- Backdating the birth time is what makes an egg ready. -->
                            <Button Content="{loc:Locale companion.make_hatchable}"
                                    Command="{Binding MakeHatchableCommand}" />
                            <Button Content="{loc:Locale companion.induce_egg}"
                                    Command="{Binding InduceEggCommand}" />
                            <Button Content="{loc:Locale common.delete}" Classes="danger"
                                    Command="{Binding DeleteCompanionCommand}" />
                            <Button Content="{loc:Locale common.export}" Command="{Binding ExportCompanionCommand}" />
                            <Button Content="{loc:Locale common.import}" Command="{Binding ImportCompanionCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
