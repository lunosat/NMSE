<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NMSE.UI.ViewModels.Panels"
             xmlns:controls="using:NMSE.UI.Views.Controls"
             xmlns:loc="using:NMSE.UI.Localization"
             x:Class="NMSE.UI.Views.Panels.StarshipView"
             x:DataType="vm:StarshipViewModel">

    <Border Classes="card" Padding="16" Margin="4">
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="{loc:Locale starship.title}" Classes="sectionHeader"
                       VerticalAlignment="Center" />
                <Button Classes="gotoJson" Padding="6,2" Margin="8,0,0,0"
                        Command="{Binding GoToShipJsonCommand}"
                        ToolTip.Tip="{Binding GoToListTooltip}" />
                <Button Classes="gotoJson" Padding="6,2" Margin="4,0,0,0"
                        Command="{Binding GoToSelectedShipJsonCommand}"
                        ToolTip.Tip="{Binding GoToSelectedTooltip}" />
                <Button Classes="gotoJson" Padding="6,2" Margin="4,0,0,0"
                        Command="{Binding GoToShipCargoJsonCommand}"
                        ToolTip.Tip="{Binding GoToCargoTooltip}" />
                <Button Classes="gotoJson" Padding="6,2" Margin="4,0,0,0"
                        Command="{Binding GoToShipResourceJsonCommand}"
                        ToolTip.Tip="{Binding GoToResourceTooltip}" />
            </StackPanel>

            <Grid ColumnDefinitions="320,16,*">
                <!-- Left: Selection and Details -->
                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Text="{loc:Locale starship.select}" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding ShipList}"
                              SelectedIndex="{Binding SelectedShipIndex}"
                              HorizontalAlignment="Stretch" />

                    <TextBlock Text="{Binding PrimaryShipLabel, StringFormat='Primary: {0}'}"
                               FontStyle="Italic" Opacity="0.7" Margin="0,4,0,8" />

                    <TextBlock Text="{loc:Locale starship.details}" FontWeight="SemiBold" Margin="0,4,0,4" />

                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Locale starship.name}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ShipName}"
                                 Watermark="{loc:Locale common.procedural_no_name}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Locale starship.type}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ShipTypes}"
                                  SelectedIndex="{Binding SelectedTypeIndex}"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Locale starship.class}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ShipClasses}"
                                  SelectedIndex="{Binding SelectedClassIndex}"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Locale starship.seed}" VerticalAlignment="Center" />
                        <DockPanel Grid.Row="3" Grid.Column="1">
                            <Button Content="{loc:Locale common.generate}" DockPanel.Dock="Right" Margin="4,0,0,0"
                                    Command="{Binding GenerateSeedCommand}" />
                            <TextBox Text="{Binding ShipSeed}" />
                        </DockPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="" />
                        <CheckBox Grid.Row="4" Grid.Column="1" Content="{loc:Locale starship.use_old_colour}"
                                  IsChecked="{Binding UseOldColours}" />
                    </Grid>

                    <TextBlock Text="{loc:Locale starship.base_stats}" FontWeight="SemiBold" Margin="0,12,0,4" />

                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Locale starship.damage}" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Damage}"
                                       FormatString="F1" Minimum="0" Maximum="99999"
                                       HorizontalAlignment="Stretch" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Locale starship.shield}" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Shield}"
                                       FormatString="F1" Minimum="0" Maximum="99999"
                                       HorizontalAlignment="Stretch" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Locale starship.hyperdrive}" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Hyperdrive}"
                                       FormatString="F1" Minimum="0" Maximum="99999"
                                       HorizontalAlignment="Stretch" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Locale starship.maneuverability}" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Maneuver}"
                                       FormatString="F1" Minimum="0" Maximum="99999"
                                       HorizontalAlignment="Stretch" />
                    </Grid>

                    <Button Content="{loc:Locale starship.make_primary}" Margin="0,12,0,0"
                            Command="{Binding MakePrimaryCommand}"
                            HorizontalAlignment="Stretch" />

                    <Rectangle Height="1" Fill="{DynamicResource NmseBorderBrush}" Margin="0,12,0,8" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="{loc:Locale starship.export}" Command="{Binding ExportShipCommand}" />
                        <Button Content="{loc:Locale starship.import}" Command="{Binding ImportShipCommand}" />
                        <Button Content="{loc:Locale starship.delete}" Classes="danger"
                                Command="{Binding DeleteShipCommand}" />
                    </StackPanel>

                    <Button Content="{loc:Locale starship.archive_move_btn}" Margin="0,4,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ArchiveShipCommand}" />

                    <!-- Corvettes render their parts in list order, so an unsorted base
                         shows the ship built wrong. -->
                    <StackPanel IsVisible="{Binding IsCorvette}" Spacing="4" Margin="0,8,0,0">
                        <Button Content="{loc:Locale starship.optimise}" HorizontalAlignment="Stretch"
                                Command="{Binding OptimiseCorvetteCommand}" />
                        <!-- A snapshot carries the build and its technology but not the
                             cargo, which belongs to the save it came from. -->
                        <Button Content="{loc:Locale starship.export_snapshot}" HorizontalAlignment="Stretch"
                                Command="{Binding ExportSnapshotCommand}" />
                        <Button Content="{loc:Locale starship.import_snapshot}" HorizontalAlignment="Stretch"
                                Command="{Binding ImportSnapshotCommand}" />
                        <TextBlock Text="{loc:Locale starship.corvette_warning}" Classes="hint"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Inventories -->
                <DockPanel Grid.Column="2">
                    <TabControl>
                        <TabItem Header="{loc:Locale starship.tab_cargo}">
                            <controls:InventoryGridControl DataContext="{Binding CargoGrid}" />
                        </TabItem>
                        <TabItem Header="{loc:Locale starship.tab_tech}">
                            <controls:InventoryGridControl DataContext="{Binding TechGrid}" />
                        </TabItem>

                        <TabItem Header="{loc:Locale starship.tab_customisation}">
                            <ScrollViewer>
                                <StackPanel Margin="8" Spacing="6">
                                    <!-- Scene resource decides which customisation config applies. -->
                                    <TextBlock Text="{loc:Locale starship.customisation_scene_label}" Classes="label" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Margin="4,0,0,0"
                                                Content="{loc:Locale common.apply}"
                                                Command="{Binding ApplySceneCommand}" />
                                        <ComboBox ItemsSource="{Binding SceneResources}"
                                                  SelectedItem="{Binding SceneResource}"
                                                  IsTextSearchEnabled="True"
                                                  HorizontalAlignment="Stretch" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding CustomisationMessage}" Classes="hint"
                                               TextWrapping="Wrap" Margin="0,8,0,0"
                                               IsVisible="{Binding !CustomisationAvailable}" />

                                    <StackPanel IsVisible="{Binding CustomisationAvailable}" Spacing="6">
                                        <TextBlock Text="{loc:Locale starship.customisation_combo_warning}"
                                                   Foreground="{DynamicResource NmseWarningBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,4" />

                                        <TextBlock Text="{loc:Locale starship.customisation_parts_heading}"
                                                   Classes="sectionHeader" Margin="0,8,0,4"
                                                   IsVisible="{Binding PartSlots.Count}" />
                                        <ItemsControl ItemsSource="{Binding PartSlots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ShipPartSlotViewModel">
                                                    <Grid ColumnDefinitions="170,*" Margin="0,2">
                                                        <TextBlock Text="{Binding Label}" Classes="label" />
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                                                  SelectedIndex="{Binding SelectedIndex}"
                                                                  HorizontalAlignment="Stretch" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{loc:Locale starship.customisation_texture_heading}"
                                                   Classes="sectionHeader" Margin="0,12,0,4"
                                                   IsVisible="{Binding TextureGroups.Count}" />
                                        <ItemsControl ItemsSource="{Binding TextureGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ShipTextureGroupViewModel">
                                                    <Grid ColumnDefinitions="170,*" Margin="0,2">
                                                        <TextBlock Text="{Binding Label}" Classes="label" />
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                                                  SelectedIndex="{Binding SelectedIndex}"
                                                                  HorizontalAlignment="Stretch" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{loc:Locale starship.customisation_colours_heading}"
                                                   Classes="sectionHeader" Margin="0,12,0,4" />

                                        <Grid ColumnDefinitions="170,*" Margin="0,2"
                                              IsVisible="{Binding Palettes.Count}">
                                            <TextBlock Text="{loc:Locale starship.customisation_paint_palette}"
                                                       Classes="label" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding PaletteNames}"
                                                      SelectedIndex="{Binding SelectedPaletteIndex}"
                                                      HorizontalAlignment="Stretch" />
                                        </Grid>

                                        <TextBlock Text="{loc:Locale starship.customisation_sail_warning}"
                                                   Foreground="{DynamicResource NmseWarningBrush}"
                                                   TextWrapping="Wrap" Margin="0,4"
                                                   IsVisible="{Binding ShowSailColourWarning}" />

                                        <!-- Each channel opens the palette grid it draws from. -->
                                        <ItemsControl ItemsSource="{Binding ColourChannels}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ShipColourChannelViewModel">
                                                    <Grid ColumnDefinitions="170,*" Margin="0,3">
                                                        <TextBlock Text="{Binding Label}" Classes="label" />
                                                        <Button Grid.Column="1" HorizontalAlignment="Left"
                                                                Width="140" Height="26" Padding="0"
                                                                Background="{Binding Swatch}">
                                                            <Button.Flyout>
                                                                <Flyout>
                                                                    <ItemsControl ItemsSource="{Binding Choices}"
                                                                                  Width="300">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:ShipPaletteSwatch">
                                                                                <Button Width="28" Height="28" Margin="2"
                                                                                        Padding="0"
                                                                                        Background="{Binding Brush}"
                                                                                        ToolTip.Tip="{Binding Name}"
                                                                                        Tag="{Binding $parent[ItemsControl].DataContext}"
                                                                                        Click="OnColourSwatchClick" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="{loc:Locale starship.archive_move_btn}">
                            <DockPanel Margin="8">
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                            Spacing="6" Margin="0,8,0,0">
                                    <Button Content="{loc:Locale starship.archive_import_btn}"
                                            Command="{Binding ImportFromArchiveCommand}" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{loc:Locale starship.archive_empty}"
                                           Classes="hint" Margin="0,0,0,8"
                                           IsVisible="{Binding !ArchivedShips.Count}" />
                                <ListBox ItemsSource="{Binding ArchivedShips}"
                                         SelectedIndex="{Binding SelectedArchiveIndex}" />
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
