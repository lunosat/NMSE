<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NMSE.UI.ViewModels.Panels"
             xmlns:loc="using:NMSE.UI.Localization"
             xmlns:util="using:NMSE.UI.Util"
             xmlns:views="using:NMSE.UI.Views.Panels"
             x:Class="NMSE.UI.Views.Panels.DiscoveryView"
             x:DataType="vm:DiscoveryViewModel">

    <Border Classes="card" Padding="16" Margin="4">
        <DockPanel>
            <TextBlock Text="{loc:Locale tab.discoveries}" Classes="sectionHeader"
                       DockPanel.Dock="Top" Margin="0,0,0,12" />

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Classes="hint"
                       Margin="0,6,0,0"
                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TabControl SelectedIndex="{Binding SelectedTabIndex}">
                <!-- Known Technologies -->
                <TabItem Header="{loc:Locale discovery.tab_tech}">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <TextBox Text="{Binding TechFilter}" Watermark="{loc:Locale discovery.filter_items}" Width="250" />
                            <Button Content="X" Command="{Binding ClearTechFilterCommand}"
                                    ToolTip.Tip="{loc:Locale common.filter}" Width="30" />
                            <Button Classes="gotoJson" Padding="6,2" Command="{Binding GoToTechJsonCommand}" ToolTip.Tip="{loc:Locale goto_json.tooltip}" />
                            <Button Content="{loc:Locale discovery.remove_selected}" Command="{Binding RemoveTechCommand}" />
                            <Button Content="{loc:Locale discovery.add_technology}" Command="{Binding AddTechCommand}" />
                            <Button Content="{loc:Locale common.export}" Command="{Binding ExportTechCommand}" />
                            <Button Content="{loc:Locale common.import}" Command="{Binding ImportTechCommand}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding FilteredTechs}" SelectionMode="Single"
                                 SelectedItem="{Binding SelectedTech}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiscoveryItemViewModel">
                                    <Grid ColumnDefinitions="*,120,180">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{DynamicResource NmseText1Brush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Id}" Foreground="{DynamicResource NmseText1Brush}" FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <!-- Known Products -->
                <TabItem Header="{loc:Locale discovery.tab_products}">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <TextBox Text="{Binding ProductFilter}" Watermark="{loc:Locale discovery.filter_items}" Width="250" />
                            <Button Content="X" Command="{Binding ClearProductFilterCommand}"
                                    ToolTip.Tip="{loc:Locale common.filter}" Width="30" />
                            <Button Classes="gotoJson" Padding="6,2" Command="{Binding GoToProductJsonCommand}" ToolTip.Tip="{loc:Locale goto_json.tooltip}" />
                            <Button Content="{loc:Locale discovery.remove_selected}" Command="{Binding RemoveProductCommand}" />
                            <Button Content="{loc:Locale discovery.add_product}" Command="{Binding AddProductCommand}" />
                            <Button Content="{loc:Locale common.export}" Command="{Binding ExportProductCommand}" />
                            <Button Content="{loc:Locale common.import}" Command="{Binding ImportProductCommand}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding FilteredProducts}" SelectionMode="Single"
                                 SelectedItem="{Binding SelectedProduct}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiscoveryItemViewModel">
                                    <Grid ColumnDefinitions="*,120,180">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{DynamicResource NmseText1Brush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Id}" Foreground="{DynamicResource NmseText1Brush}" FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <!-- Glyphs -->
                <TabItem Header="{loc:Locale discovery.tab_glyphs}">
                    <ScrollViewer>
                        <StackPanel Spacing="12" Margin="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Locale discovery.learn_all}" Command="{Binding LearnAllGlyphsCommand}" />
                                <Button Content="{loc:Locale discovery.unlearn_all}" Command="{Binding UnlearnAllGlyphsCommand}" />
                                <Button Classes="gotoJson" Padding="6,2" Command="{Binding GoToGlyphJsonCommand}" ToolTip.Tip="{loc:Locale goto_json.tooltip}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Glyphs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GlyphViewModel">
                                        <Border Classes="card" Padding="8" Margin="4" MinWidth="100">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"
                                                           FontWeight="SemiBold" />
                                                <CheckBox IsChecked="{Binding IsKnown}" HorizontalAlignment="Center"
                                                          Content="{loc:Locale discovery.tab_glyphs}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Fishing -->
                <TabItem Header="{loc:Locale discovery.tab_fish}">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <TextBlock Text="{loc:Locale discovery.tab_fish}" Classes="sectionHeader"
                                       VerticalAlignment="Center" />
                            <TextBox Text="{Binding FishFilter}" Width="220"
                                     Watermark="{loc:Locale discovery.filter_fish}" />
                            <Button Content="{loc:Locale discovery.add_fish_title}" Command="{Binding AddFishCommand}" />
                            <Button Content="{loc:Locale common.import}" Command="{Binding ImportFishCommand}" />
                            <Button Content="{loc:Locale common.remove_selected}" Classes="danger"
                                    Command="{Binding RemoveFishCommand}" />
                            <Button Classes="gotoJson" Padding="6,2" Command="{Binding GoToFishJsonCommand}" ToolTip.Tip="{loc:Locale goto_json.tooltip}" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding FilteredFish}" SelectedItem="{Binding SelectedFish}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Locale discovery.col_caught_fish}" Binding="{Binding ProductId}" Width="200" />
                                <DataGridTextColumn Header="{loc:Locale discovery.col_name}" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="{loc:Locale discovery.col_count}" Binding="{Binding CatchCount}" Width="120" />
                                <DataGridTextColumn Header="{loc:Locale discovery.col_largest_catch}" Binding="{Binding LargestCatch}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Known Specials -->
                <TabItem Header="{loc:Locale discovery.tab_specials}">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <TextBox Text="{Binding SpecialFilter}"
                                     Watermark="{loc:Locale discovery.filter_placeholder}" Width="250" />
                            <Button Content="{loc:Locale common.remove_selected}" Command="{Binding RemoveSpecialCommand}" />
                            <Button Content="{loc:Locale discovery.add_special}" Command="{Binding AddSpecialCommand}" />
                            <Button Classes="gotoJson" Padding="6,2" Command="{Binding GoToSpecialJsonCommand}" ToolTip.Tip="{loc:Locale goto_json.tooltip}" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding FilteredSpecials}" SelectedItem="{Binding SelectedSpecial}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Locale discovery.col_name}" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="{loc:Locale discovery.col_category}" Binding="{Binding Category}" Width="160" />
                                <DataGridTextColumn Header="{loc:Locale discovery.col_id}" Binding="{Binding Id}" Width="220" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Words. A word can belong to several races, each tracking it
                     separately, so the race selector decides which flag is shown. -->
                <TabItem Header="{loc:Locale discovery.tab_words}">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <ComboBox ItemsSource="{Binding WordRaces}"
                                      SelectedIndex="{Binding SelectedWordRaceIndex}" MinWidth="140" />
                            <TextBox Text="{Binding WordFilter}"
                                     Watermark="{loc:Locale discovery.filter_words}" Width="250" />
                            <Button Content="{loc:Locale discovery.learn_selected}" Command="{Binding LearnAllWordsCommand}" />
                            <Button Content="{loc:Locale discovery.unlearn_selected}" Command="{Binding UnlearnAllWordsCommand}" />
                            <Button Content="{loc:Locale common.import}" Command="{Binding ImportWordsCommand}" />
                            <Button Classes="gotoJson" Padding="6,2" Command="{Binding GoToWordJsonCommand}" ToolTip.Tip="{loc:Locale goto_json.tooltip}" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Words}" AutoGenerateColumns="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="{loc:Locale discovery.col_known}"
                                                        Binding="{Binding IsKnown}" Width="70" />
                                <DataGridTextColumn Header="{loc:Locale discovery.col_word}"
                                                    Binding="{Binding Text}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="{loc:Locale discovery.col_word_id}"
                                                    Binding="{Binding Id}" Width="240" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Locations: the teleport endpoints the save records, which is every
                     place the player can travel back to. -->
                <TabItem Header="{loc:Locale discovery.tab_locations}">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <TextBox Text="{Binding LocationFilter}"
                                     Watermark="{loc:Locale discovery.filter_locations}" Width="250" />
                            <Button Content="{loc:Locale discovery.travel_to_system}"
                                    Classes="primary" Command="{Binding TravelToSystemCommand}" />
                            <Button Content="{loc:Locale common.import}" Command="{Binding ImportLocationsCommand}" />
                            <Button Content="{loc:Locale discovery.delete_selected}" Classes="danger"
                                    Command="{Binding DeleteLocationCommand}" />
                            <Button Classes="gotoJson" Padding="6,2" Command="{Binding GoToLocationJsonCommand}" ToolTip.Tip="{loc:Locale goto_json.tooltip}" />
                        </StackPanel>
                        <!-- The address of whichever location is highlighted, drawn as
                             the game's own glyphs. -->
                        <Border DockPanel.Dock="Bottom" Classes="card" Padding="10" Margin="0,8,0,0"
                                IsVisible="{Binding SelectedLocation, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{loc:Locale discovery.portal_glyphs}" Classes="label"
                                           VerticalAlignment="Center" />
                                <util:PortalGlyphStrip PortalCode="{Binding SelectedLocation.PortalHex}"
                                                       GlyphSize="20" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Locale discovery.galaxy}" Classes="label"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                <TextBlock Text="{Binding SelectedLocation.Galaxy}" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Locale player.core_label}" Classes="label"
                                           VerticalAlignment="Center" />
                                <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                                         Fill="{Binding SelectedLocation.CoreBrush}" />
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="LocationsGrid" ItemsSource="{Binding Locations}"
                                  SelectedItem="{Binding SelectedLocation}"
                                  SelectionChanged="OnLocationsSelectionChanged"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Extended">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Locale discovery.col_index}" Binding="{Binding Index}" Width="60" />
                                <DataGridTextColumn Header="{loc:Locale discovery.col_type}" Binding="{Binding TypeName}" Width="180" />
                                <DataGridTextColumn Header="{loc:Locale discovery.col_galaxy}" Binding="{Binding Galaxy}" Width="160" />
                                <DataGridTextColumn Header="{loc:Locale discovery.col_portal_hex}" Binding="{Binding PortalHex}" Width="160" />
                                <DataGridTextColumn Header="{loc:Locale discovery.col_portal_dec}" Binding="{Binding PortalDec}" Width="200" />
                                <DataGridTextColumn Header="{loc:Locale discovery.col_signal_booster}" Binding="{Binding SignalBooster}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Recipes -->
                <TabItem Header="{loc:Locale discovery.tab_recipes}">
                    <views:RecipeView DataContext="{Binding Recipe}" />
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
