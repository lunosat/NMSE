<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NMSE.UI.ViewModels.Panels"
             xmlns:loc="using:NMSE.UI.Localization"
             x:Class="NMSE.UI.Views.Panels.AccountView"
             x:DataType="vm:AccountViewModel">

    <Border Classes="card" Padding="16" Margin="4">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                <!-- Redeemed* and Known* can disagree, which leaves an unlocked reward
                     the game will not hand over. -->
                <Button Content="{loc:Locale account.consistency_check}"
                        Command="{Binding CheckConsistencyCommand}" />
                <TextBlock Text="{loc:Locale account.twitch_warning}" Classes="hint"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="700" />
            </StackPanel>

            <TextBlock Text="{loc:Locale account.tab_season}" Classes="sectionHeader"
                       DockPanel.Dock="Top" Margin="0,0,0,4" />

            <TextBlock Text="{Binding StatusText}" DockPanel.Dock="Top"
                       Opacity="0.7" Margin="0,0,0,12" />

            <TabControl>
                <!-- Season Rewards -->
                <TabItem Header="{loc:Locale account.tab_season}">
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button Content="{loc:Locale account.unlock_all}" Command="{Binding UnlockAllSeasonCommand}" />
                            <Button Content="{loc:Locale account.lock_all}" Command="{Binding LockAllSeasonCommand}" />
                            <Button Content="{loc:Locale account.redeem_all}" Command="{Binding RedeemAllSeasonCommand}" />
                            <Button Content="{loc:Locale account.remove_all}" Command="{Binding RemoveAllSeasonCommand}" />
                            <TextBlock Text="{loc:Locale common.filter}" VerticalAlignment="Center" Margin="16,0,4,0" />
                            <TextBox Text="{Binding SeasonFilter}" Width="200" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding FilteredSeasonRewards}"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="True"
                                  IsReadOnly="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Locale account.col_reward_id}" Binding="{Binding RewardId}" IsReadOnly="True" Width="200" />
                                <DataGridTextColumn Header="{loc:Locale account.col_name}" Binding="{Binding RewardName}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="{loc:Locale account.col_expedition}" Binding="{Binding Expedition}" IsReadOnly="True" Width="100" />
                                <DataGridCheckBoxColumn Header="{loc:Locale account.col_unlocked}" Binding="{Binding IsUnlocked}" Width="150" />
                                <DataGridCheckBoxColumn Header="{loc:Locale account.col_redeemed}" Binding="{Binding IsRedeemed}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Twitch Rewards -->
                <TabItem Header="{loc:Locale account.tab_twitch}">
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Warning: Twitch rewards require a linked Twitch account"
                                   Foreground="#E0A030" FontWeight="SemiBold" FontSize="12"
                                   Margin="0,0,0,8" />
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button Content="{loc:Locale account.unlock_all}" Command="{Binding UnlockAllTwitchCommand}" />
                            <Button Content="{loc:Locale account.lock_all}" Command="{Binding LockAllTwitchCommand}" />
                            <Button Content="{loc:Locale account.redeem_all}" Command="{Binding RedeemAllTwitchCommand}" />
                            <Button Content="{loc:Locale account.remove_all}" Command="{Binding RemoveAllTwitchCommand}" />
                            <TextBlock Text="{loc:Locale common.filter}" VerticalAlignment="Center" Margin="16,0,4,0" />
                            <TextBox Text="{Binding TwitchFilter}" Width="200" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding FilteredTwitchRewards}"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="True"
                                  IsReadOnly="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Locale account.col_reward_id}" Binding="{Binding RewardId}" IsReadOnly="True" Width="200" />
                                <DataGridTextColumn Header="{loc:Locale account.col_name}" Binding="{Binding RewardName}" IsReadOnly="True" Width="*" />
                                <DataGridCheckBoxColumn Header="{loc:Locale account.col_unlocked}" Binding="{Binding IsUnlocked}" Width="150" />
                                <DataGridCheckBoxColumn Header="{loc:Locale account.col_redeemed}" Binding="{Binding IsRedeemed}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Platform Rewards -->
                <TabItem Header="{loc:Locale account.tab_platform}">
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Warning: Platform rewards require specific platform configurations"
                                   Foreground="#E0A030" FontWeight="SemiBold" FontSize="12"
                                   Margin="0,0,0,8" />
                        <!-- On PC the game keeps platform rewards in GCUSERSETTINGSDATA.MXML
                             as well as in the account blob, so both have to be written.
                             Consoles carry them in the blob alone. -->
                        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8"
                                    IsVisible="{Binding ShowMxml}">
                            <TextBlock Text="{loc:Locale account.platform_mxml_info}"
                                       TextWrapping="Wrap" Classes="hint" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="6,0,0,0"
                                        Content="{loc:Locale common.browse}"
                                        Command="{Binding BrowseMxmlCommand}" />
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                           Margin="6,0,0,0" Text="{Binding MxmlStatus}" />
                                <TextBox Text="{Binding MxmlPath}" IsReadOnly="True"
                                         Watermark="{loc:Locale account.platform_mxml_placeholder}" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button Content="{loc:Locale account.unlock_all}" Command="{Binding UnlockAllPlatformCommand}" />
                            <Button Content="{loc:Locale account.lock_all}" Command="{Binding LockAllPlatformCommand}" />
                            <Button Content="{loc:Locale account.redeem_all}" Command="{Binding RedeemAllPlatformCommand}" />
                            <Button Content="{loc:Locale account.remove_all}" Command="{Binding RemoveAllPlatformCommand}" />
                            <TextBlock Text="{loc:Locale common.filter}" VerticalAlignment="Center" Margin="16,0,4,0" />
                            <TextBox Text="{Binding PlatformFilter}" Width="200" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding FilteredPlatformRewards}"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="True"
                                  IsReadOnly="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Locale account.col_reward_id}" Binding="{Binding RewardId}" IsReadOnly="True" Width="200" />
                                <DataGridTextColumn Header="{loc:Locale account.col_name}" Binding="{Binding RewardName}" IsReadOnly="True" Width="*" />
                                <DataGridCheckBoxColumn Header="{loc:Locale account.col_unlocked}" Binding="{Binding IsUnlocked}" Width="150" />
                                <DataGridCheckBoxColumn Header="{loc:Locale account.col_redeemed}" Binding="{Binding IsRedeemed}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
