<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NMSE.UI.ViewModels.Panels"
             xmlns:controls="using:NMSE.UI.Views.Controls"
             xmlns:loc="using:NMSE.UI.Localization"
             x:Class="NMSE.UI.Views.Panels.ExosuitView"
             x:DataType="vm:ExosuitViewModel">

    <Border Classes="card" Padding="16" Margin="4">
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="{loc:Locale exosuit.title}" Classes="sectionHeader"
                       VerticalAlignment="Center" />
                <Button Content="{}" Padding="6,2" Margin="8,0,0,0"
                               Command="{Binding GoToInventoryJsonCommand}"
                               ToolTip.Tip="{loc:Locale goto_json.tooltip}" />
            </StackPanel>

            <TabControl>
                <TabItem Header="{loc:Locale common.cargo}">
                    <controls:InventoryGridControl DataContext="{Binding CargoGrid}" />
                </TabItem>
                <TabItem Header="{loc:Locale common.technology}">
                    <controls:InventoryGridControl DataContext="{Binding TechGrid}" />
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
